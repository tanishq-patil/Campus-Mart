<%= form_with(model: product) do |form| %>
  <% if product.errors.any? %>
    <div class="flash-alert" style="margin-bottom: 1.5rem;">
      <div>
        <strong style="display: block; margin-bottom: 0.25rem;"><%= pluralize(product.errors.count, "error") %> prohibited this product from being saved:</strong>
        <ul style="margin-left: 1.25rem; font-size: 0.9rem;">
          <% product.errors.each do |error| %>
            <li><%= error.full_message %></li>
          <% end %>
        </ul>
      </div>
    </div>
  <% end %>

  <div class="form-group">
    <%= form.label :name, "Product Name", class: "form-label" %>
    <%= form.text_field :name, class: "form-control", placeholder: "e.g., Engineering Physics Textbook 3rd Ed", required: true %>
  </div>

  <div class="form-group">
    <%= form.label :categorie, "Category", class: "form-label" %>
    <%= form.text_field :categorie, class: "form-control", placeholder: "e.g., Textbooks, Electronics, Dorm, Apparel", list: "categories-list" %>
    <datalist id="categories-list">
      <option value="Textbooks">
      <option value="Electronics">
      <option value="Dorm & Furniture">
      <option value="Stationery">
      <option value="Sports & Fitness">
      <option value="Apparel & Accessories">
      <option value="Other">
    </datalist>
  </div>

  <div class="form-group">
    <%= form.label :price, "Price ($)", class: "form-label" %>
    <%= form.number_field :price, class: "form-control", placeholder: "0.00", step: "0.01", min: "0", required: true %>
  </div>

  <div class="form-actions">
    <%= form.submit product.new_record? ? "Post Listing" : "Update Listing", class: "btn btn-primary btn-lg" %>
    <%= link_to "Cancel", products_path, class: "btn btn-secondary" %>
  </div>
<% end %>
