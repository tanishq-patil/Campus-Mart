<% content_for :title, "Campus Mart - Browse Products" %>

<!-- Hero Banner -->
<div class="hero-banner">
  <div class="hero-content">
    <div class="hero-badge">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 2L2 7l10 5 10-5-10-5z"></path><path d="M2 17l10 5 10-5"></path><path d="M2 12l10 5 10-5"></path></svg>
      Official Student Exchange
    </div>
    <h1 class="hero-title">Buy, Sell & Trade Campus Essentials</h1>
    <p class="hero-subtitle">Find textbooks, electronics, dorm gear, and more from students on your campus at friendly prices.</p>
    <%= link_to new_product_path, class: "btn btn-primary btn-lg" do %>
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
      List Your Item Now
    <% end %>
  </div>
</div>

<!-- Stats Counter Grid -->
<div class="stats-grid">
  <div class="stat-card">
    <div class="stat-icon">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path></svg>
    </div>
    <div>
      <div class="stat-number"><%= @products.count %></div>
      <div class="stat-label">Active Listings</div>
    </div>
  </div>
  <div class="stat-card">
    <div class="stat-icon" style="background: #ecfdf5; color: #10b981;">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path></svg>
    </div>
    <div>
      <div class="stat-number"><%= @products.map(&:categorie).uniq.reject(&:blank?).count %></div>
      <div class="stat-label">Categories</div>
    </div>
  </div>
  <div class="stat-card">
    <div class="stat-icon" style="background: #fef3c7; color: #d97706;">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="1" x2="12" y2="23"></line><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path></svg>
    </div>
    <div>
      <div class="stat-number">
        <% if @products.any? %>
          $<%= sprintf("%.2f", @products.map(&:price).compact.sum / [@products.count, 1].max) %>
        <% else %>
          $0.00
        <% end %>
      </div>
      <div class="stat-label">Avg Item Price</div>
    </div>
  </div>
</div>

<!-- Toolbar & Interactive Filter -->
<div class="toolbar-section">
  <div class="search-box-wrapper">
    <svg class="search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
    <input type="text" id="search-input" class="search-input" placeholder="Search items by title, category..." onkeyup="filterProducts()">
  </div>

  <div class="category-pills" id="category-pills">
    <button class="pill-btn active" onclick="filterCategory('all items', this)">All Items</button>
    <% categories = @products.map(&:categorie).reject(&:blank?).uniq %>
    <% categories.each do |cat| %>
      <button class="pill-btn" onclick="filterCategory('<%= cat.downcase.gsub("'", "\\'") %>', this)"><%= cat.titleize %></button>
    <% end %>
  </div>
</div>

<!-- Section Title -->
<div class="section-header">
  <h2 class="section-title">Campus Listings</h2>
  <span class="items-count" id="items-count-label">Showing <%= @products.count %> items</span>
</div>

<!-- Products Grid -->
<div id="products-grid" class="products-grid">
  <% if @products.any? %>
    <% @products.each do |product| %>
      <%= render product %>
    <% end %>
  <% end %>
</div>

<!-- Empty State Container -->
<div id="empty-state-view" class="empty-state" style="<%= @products.empty? ? '' : 'display: none;' %>">
  <div class="empty-icon">
    <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="8" y1="12" x2="16" y2="12"></line></svg>
  </div>
  <h3 class="empty-title">No products found</h3>
  <p class="empty-desc">We couldn't find any listings matching your search or filter. Try clearing filters or list a new item!</p>
  <%= link_to "+ Post New Item", new_product_path, class: "btn btn-primary" %>
</div>

<!-- Interactive Client-side Filter Script -->
<script>
function filterProducts() {
  const query = document.getElementById('search-input').value.toLowerCase().trim();
  const cards = document.querySelectorAll('.product-card');
  let visibleCount = 0;

  cards.forEach(card => {
    const title = card.getAttribute('data-name') || '';
    const category = card.getAttribute('data-category') || '';
    const activePill = document.querySelector('.pill-btn.active');
    const selectedCat = activePill ? activePill.innerText.toLowerCase() : 'all items';

    const matchesSearch = title.includes(query) || category.includes(query);
    const matchesCategory = (selectedCat === 'all items') || (category === selectedCat);

    if (matchesSearch && matchesCategory) {
      card.style.display = 'flex';
      visibleCount++;
    } else {
      card.style.display = 'none';
    }
  });

  updateCountAndEmptyState(visibleCount);
}

function filterCategory(cat, btn) {
  document.querySelectorAll('.pill-btn').forEach(b => b.classList.remove('active'));
  btn.classList.add('active');
  filterProducts();
}

function updateCountAndEmptyState(count) {
  const countLabel = document.getElementById('items-count-label');
  const emptyState = document.getElementById('empty-state-view');
  if (countLabel) countLabel.innerText = 'Showing ' + count + ' item' + (count === 1 ? '' : 's');
  if (emptyState) emptyState.style.display = count === 0 ? 'block' : 'none';
}
</script>
