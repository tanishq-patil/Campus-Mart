<div id="<%= dom_id product %>" class="product-card">
  <p>
    <strong>Name:</strong>
    <%= product.name %>
  </p>

  <div class="card-body">
    <h3 class="product-title"><%= product.name.presence || "Untitled Product" %></h3>
    <div class="product-price">
      $<%= sprintf("%.2f", product.price || 0) %>
    </div>

    <div class="product-meta">
      <span>Listed <%= product.created_at ? time_ago_in_words(product.created_at) + " ago" : "Recently" %></span>
      <span>ID #<%= product.id %></span>
    </div>
  </div>

  <div class="card-actions">
    <%= link_to product, class: "btn btn-secondary btn-sm", style: "flex: 1;" do %>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
      Details
    <% end %>

    <%= link_to edit_product_path(product), class: "btn btn-secondary btn-sm", title: "Edit Item" do %>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
    <% end %>

    <%= button_to product, method: :delete, class: "btn btn-danger btn-sm", title: "Delete Item", data: { turbo_confirm: "Are you sure you want to delete '#{product.name}'?" } do %>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
    <% end %>
  </div>
</div>
