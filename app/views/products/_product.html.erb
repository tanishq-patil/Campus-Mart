<div id="<%= dom_id product %>" class="product-card" data-name="<%= (product.name || '').downcase %>" data-category="<%= (product.categorie || '').downcase %>">
  <div class="card-header-thumb">
    <span class="category-badge">
      <%= product.categorie.presence || "General" %>
    </span>
    <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" opacity="0.6">
      <% cat_lower = (product.categorie || '').downcase %>
      <% if cat_lower.include?('book') || cat_lower.include?('text') %>
        <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path>
      <% elsif cat_lower.include?('elect') || cat_lower.include?('tech') || cat_lower.include?('phone') || cat_lower.include?('laptop') %>
        <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect><line x1="8" y1="21" x2="16" y2="21"></line><line x1="12" y1="17" x2="12" y2="21"></line>
      <% elsif cat_lower.include?('cloth') || cat_lower.include?('wear') || cat_lower.include?('shirt') %>
        <path d="M20.38 3.46L16 2a4 4 0 01-8 0L3.62 3.46a2 2 0 00-1.34 2.23l.58 3.47a1 1 0 00.99.84H6v10a2 2 0 002 2h8a2 2 0 002-2V10h2.15a1 1 0 00.99-.84l.58-3.47a2 2 0 00-1.34-2.23z"></path>
      <% else %>
        <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path><polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline><line x1="12" y1="22.08" x2="12" y2="12"></line>
      <% end %>
    </svg>
  </div>

  <div class="card-body">
    <h3 class="product-title"><%= product.name.presence || "Untitled Product" %></h3>
    <div class="product-price">
      $<%= sprintf("%.2f", product.price || 0) %>
    </div>

    <div class="product-meta">
      <span>Listed <%= product.created_at ? time_ago_in_words(product.created_at) + " ago" : "Recently" %></span>
      <span>ID #<%= product.id %></span>
    </div>
  </div>

  <div class="card-actions">
    <%= link_to product, class: "btn btn-secondary btn-sm", style: "flex: 1;" do %>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
      Details
    <% end %>

    <%= link_to edit_product_path(product), class: "btn btn-secondary btn-sm", title: "Edit Item" do %>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
    <% end %>

    <%= button_to product, method: :delete, class: "btn btn-danger btn-sm", title: "Delete Item", data: { turbo_confirm: "Are you sure you want to delete '#{product.name}'?" } do %>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
    <% end %>
  </div>
</div>
